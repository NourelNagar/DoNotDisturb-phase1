!Assets/nappin/HouseInteriorPack/Materials/(Mat)GradientBrown.mat.meta
!Assets/nappin/HouseInteriorPack/Materials/(Mat)MetallicBlack.mat
!Assets/nappin/HouseInteriorPack/Materials/(Mat)MetallicBlack.mat.meta
Assets/nappin/HouseInteriorPack/Prefabs/*
Assets/nappin/HouseInteriorPack/Prefabs.meta
!Assets/nappin/HouseInteriorPack/Prefabs/(Prb)MediaConsole.prefab
