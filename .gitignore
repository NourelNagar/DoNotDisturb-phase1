Assets/nappin/HouseInteriorPack/Textures/*
Assets/nappin/HouseInteriorPack/Textures.meta
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientDarkbrown.png
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientDarkbrown.png.meta
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientBlack.png
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientBlack.png.meta
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientGrey.png
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientGrey.png.meta
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientBrown.png
!Assets/nappin/HouseInteriorPack/Textures/(Txt)GradientBrown.png.meta
Assets/nappin/HouseInteriorPack/HouseInteriorPack.unity
Assets/nappin/HouseInteriorPack/HouseInteriorPack.unity.meta
Assets/nappin/HouseInteriorPack/readme.txt
Assets/nappin/HouseInteriorPack/readme.txt.meta
# Unused Models (keep only the 6 FBX files referenced by SampleScene)
Assets/nappin/HouseInteriorPack/Models/*
Assets/nappin/HouseInteriorPack/Models.meta
